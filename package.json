{
  "name": "traffic-flow-toolkit-atharva",
  "version": "1.0.0",
  "description": "Lightweight JavaScript utilities for traffic sensor data, congestion classification, anomaly detection, and traffic statistics.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
