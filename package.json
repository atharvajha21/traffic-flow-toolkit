    "test:coverage": "node --experimental-test-coverage --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "traffic",
    "transportation",
    "congestion",
    "anomaly-detection",
    "sensor-data",
    "javascript",
    "utilities"
  ],
